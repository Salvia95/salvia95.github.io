# Dependencies
node_modules/
.pnpm-store/

# Build
dist/
.astro/

# Environment variables
.env
.env.local
.env.production

# macOS
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary files
*.tmp
*.temp
.temp/

# OS generated files
Thumbs.db
ehthumbs.db
src/content/.obsidian/workspace.json
src/content/.obsidian/workspace-mobile.json

# Generated deployment platform files (GitHub Pages only)
public/_redirects
public/_headers

# Content imported from the private document-repo (generated by scripts/import-content.js)
# 이 디렉토리들은 빌드 시 문서 저장소에서 채워지는 산출물이므로 커밋하지 않는다.
# (src/content/special 은 사이트 구조에 가까워 코드 레포에 유지)
src/content/posts/
src/content/projects/
src/content/docs/

# src/content/pages 는 기본적으로 document-repo 소유(about, contact 등).
# 코드 레포가 계속 소유할 페이지만 아래처럼 예외로 되살린다.
# content-sources.config.mjs 의 pages 매핑 `keep` 목록과 반드시 일치시킬 것.
src/content/pages/*
!src/content/pages/privacy-policy.md
public/posts/
public/projects/
public/docs/
# Obsidian 볼트는 document-repo 로 이동 (cutover 후 이 디렉토리는 무시)
src/content/.obsidian/

# 이 저장소는 pnpm 을 쓴다 (packageManager 필드 + CI 의 pnpm/action-setup).
# npm 을 잘못 돌렸을 때 생기는 lockfile 이 다시 커밋되지 않도록 무시한다.
package-lock.json

# graphin MCP 서버가 만드는 로컬 코드 인덱스/워크스페이스 데이터.
# 기계마다 다시 생성되는 캐시라 커밋하지 않는다.
.graphin/
