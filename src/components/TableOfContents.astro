---
import type { Heading } from '@/types';
import Icon from './Icon.astro';
import { getTableOfContentsDepth } from '@/config';

export interface Props {
  headings: Heading[];
  // "sidebar" = floating index map, "inline" = collapsible block above the content
  variant?: 'sidebar' | 'inline';
}

const { headings, variant = 'sidebar' } = Astro.props;

// Filter and structure headings using configurable depth
const maxDepth = getTableOfContentsDepth();
const filteredHeadings = headings.filter(h => h.depth >= 2 && h.depth <= maxDepth);

// Unique id per instance so multiple ToCs (e.g. desktop sidebar + mobile inline)
// can coexist on the same page without clashing ids / aria-controls.
const listId = `toc-list-${variant}`;
---

{filteredHeadings.length > 0 && (
  <nav class={`toc-nav toc-container toc-variant-${variant} p-4 bg-white dark:bg-primary-900 rounded-xl border border-primary-200 dark:border-primary-700 shadow-lg backdrop-blur-sm bg-opacity-95 dark:bg-opacity-95`}>
    <div class="toc-content pr-2">
      <button
        class="toc-toggle w-full font-semibold text-primary-900 dark:text-primary-50 mb-3 flex items-center justify-between text-sm hover:text-highlight-600 dark:hover:text-highlight-400 transition-colors"
        aria-expanded="true"
        aria-controls={listId}
      >
        <div class="flex items-center">
          <Icon name="list" class="w-4 h-4 mr-2" />
          Contents
        </div>
        <Icon name="chevron-down" class="w-4 h-4 toc-chevron transition-transform duration-200" />
      </button>

      <ul class="space-y-2 toc-list" id={listId}>
        {filteredHeadings.map(heading => (
          <li class={`toc-item toc-level-${heading.depth}`}>
            <a
              href={`#${heading.slug}`}
              class="toc-link block text-xs leading-snug text-primary-600 dark:text-primary-300 hover:text-highlight-600 dark:hover:text-highlight-400 transition-colors py-1"
              data-heading={heading.slug}
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script>
  // Initialize every table-of-contents instance on the page.
  // Multiple ToCs can coexist (e.g. a floating desktop sidebar + a mobile
  // inline block), so each instance is wired up independently.
  function initializeTableOfContents() {
    const navs = Array.from(document.querySelectorAll('.toc-nav')) as HTMLElement[];
    const headings = Array.from(
      document.querySelectorAll('h2, h3, h4, h5, h6')
    ) as HTMLElement[];

    if (!navs.length) return;

    // Wire the collapse/expand toggle for each instance (guard against
    // double-binding, which would otherwise cancel each other out).
    navs.forEach(nav => {
      const toggle = nav.querySelector('.toc-toggle') as HTMLButtonElement | null;
      const list = nav.querySelector('.toc-list') as HTMLElement | null;
      const chevron = nav.querySelector('.toc-chevron') as HTMLElement | null;

      if (!toggle || !list || !chevron) return;
      if (toggle.dataset.tocBound === 'true') return;
      toggle.dataset.tocBound = 'true';

      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          list.style.display = 'none';
          toggle.setAttribute('aria-expanded', 'false');
          chevron.style.transform = 'rotate(90deg)';
        } else {
          list.style.display = 'block';
          toggle.setAttribute('aria-expanded', 'true');
          chevron.style.transform = 'rotate(0deg)';
        }
      });
    });

    // Highlight the active section across all instances.
    function highlightTOC() {
      const tocLinks = document.querySelectorAll('.toc-link');
      if (!tocLinks.length || !headings.length) return;

      let current = '';
      headings.forEach(heading => {
        if (heading.getBoundingClientRect().top <= 100) {
          current = heading.id;
        }
      });

      tocLinks.forEach(link => {
        const href = link.getAttribute('href')?.slice(1);
        link.classList.toggle('active', !!current && href === current);
      });
    }

    // Always call the latest highlight closure so a single scroll listener
    // keeps working across Swup page transitions (which replace the DOM).
    (window as any).__tocHighlight = highlightTOC;

    if (!(window as any).__tocScrollBound) {
      (window as any).__tocScrollBound = true;
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            const fn = (window as any).__tocHighlight;
            if (typeof fn === 'function') fn();
            ticking = false;
          });
          ticking = true;
        }
      });
    }

    highlightTOC();
  }

  // Make function globally available
  (window as any).initializeTableOfContents = initializeTableOfContents;

  // Initialize on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', initializeTableOfContents);
</script>

<style>
  .toc-level-2 {
    @apply ml-0;
  }
  
  .toc-level-3 {
    @apply ml-4;
  }
  
  .toc-level-4 {
    @apply ml-8;
  }
  
  .toc-level-5 {
    @apply ml-12;
  }
  
  .toc-level-6 {
    @apply ml-16;
  }
  
  .toc-link.active {
    @apply text-highlight-600 dark:text-highlight-400 font-medium;
  }
  
  /* Ensure proper transform origin for chevron rotation */
  .toc-chevron {
    transform-origin: center;
  }
  
  .toc-link.active::before {
    content: '';
    @apply absolute left-0 top-1/2 transform -translate-y-1/2 w-0.5 h-4 bg-highlight-600 dark:bg-highlight-400 rounded-full;
  }
  
  .toc-item {
    @apply relative;
  }
  
  .toc-nav {
    /* Fill the wrapper provided by the layout (sidebar column or inline block) */
    width: 100%;
    max-width: 100%;
  }

  .toc-content {
    /* Scrolling for the floating index map is handled by the layout wrapper
       (#sidebar), so the content flows naturally here. */
  }

  .toc-chevron {
    @apply transition-transform duration-200;
  }
</style>
