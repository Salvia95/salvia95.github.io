---
import type { SeriesInfo } from "@/utils/series";
import Icon from "./Icon.astro";

export interface Props {
  series: SeriesInfo[];
  intervalMs?: number;
}

const { series, intervalMs = 5000 } = Astro.props;
const multiple = series.length > 1;
---

{series.length > 0 && (
  <section
    class="series-carousel relative mb-10"
    data-interval={intervalMs}
    role="region"
    aria-roledescription="carousel"
    aria-label="시리즈"
    tabindex="0"
  >
    <div class="series-viewport overflow-hidden rounded-xl border border-primary-200 dark:border-primary-700 shadow-sm">
      <div class="series-track flex transition-transform duration-500 ease-out">
        {series.map((s) => (
          <a
            href={s.href}
            class="series-slide shrink-0 basis-full flex h-48 sm:h-56 md:h-64 bg-primary-50 dark:bg-primary-900 no-underline group"
          >
            {/* Left third: one-line summary */}
            <div class="series-summary basis-1/3 min-w-0 p-4 sm:p-5 md:p-6 flex flex-col justify-center gap-2">
              <span class="text-[0.7rem] sm:text-xs font-semibold uppercase tracking-wide text-highlight-600 dark:text-highlight-400">
                시리즈 · {s.count}개 글
              </span>
              <h2 class="text-sm sm:text-base md:text-lg font-bold text-primary-900 dark:text-primary-50 leading-snug line-clamp-2 group-hover:text-highlight-600 dark:group-hover:text-highlight-400 transition-colors">
                {s.title}
              </h2>
              {s.summary && (
                <p class="text-xs sm:text-sm text-primary-600 dark:text-primary-300 leading-snug line-clamp-2 sm:line-clamp-3">
                  {s.summary}
                </p>
              )}
            </div>

            {/* Right two-thirds: representative image */}
            <div class="series-image basis-2/3 relative overflow-hidden bg-primary-100 dark:bg-primary-800">
              {s.imageUrl ? (
                <img
                  src={s.imageUrl}
                  alt={s.imageAlt}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-highlight-500/20 to-primary-400/20 dark:from-highlight-400/20 dark:to-primary-600/20" />
              )}
            </div>
          </a>
        ))}
      </div>
    </div>

    {multiple && (
      <>
        <button
          type="button"
          class="series-prev absolute left-2 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-9 h-9 rounded-full bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm transition-colors"
          aria-label="이전 시리즈"
        >
          <Icon name="arrow-left" class="w-5 h-5" />
        </button>
        <button
          type="button"
          class="series-next absolute right-2 top-1/2 -translate-y-1/2 z-10 flex items-center justify-center w-9 h-9 rounded-full bg-black/30 hover:bg-black/50 text-white backdrop-blur-sm transition-colors"
          aria-label="다음 시리즈"
        >
          <Icon name="arrow-right" class="w-5 h-5" />
        </button>

        <div class="series-dots absolute bottom-3 left-1/2 -translate-x-1/2 z-10 flex items-center gap-2">
          {series.map((s, i) => (
            <button
              type="button"
              class="series-dot"
              data-index={i}
              aria-label={`${i + 1}번째 시리즈로 이동`}
            >
              <span class="series-dot-fill" />
            </button>
          ))}
        </div>
      </>
    )}
  </section>
)}

<script>
  function initSeriesCarousels() {
    const W = window as any;
    // Clear timers left over from a previous page (Swup replaces the DOM but
    // does not clear intervals) to avoid leaks / duplicate advancing.
    (W.__seriesTimers || (W.__seriesTimers = [])).forEach((t: number) =>
      window.clearInterval(t)
    );
    W.__seriesTimers = [];

    const carousels = Array.from(
      document.querySelectorAll(".series-carousel")
    ) as HTMLElement[];

    carousels.forEach((el) => {
      const track = el.querySelector(".series-track") as HTMLElement | null;
      const slides = Array.from(
        el.querySelectorAll(".series-slide")
      ) as HTMLElement[];
      const dots = Array.from(
        el.querySelectorAll(".series-dot")
      ) as HTMLElement[];
      const fills = dots.map(
        (d) => d.querySelector(".series-dot-fill") as HTMLElement | null
      );
      const prev = el.querySelector(".series-prev") as HTMLElement | null;
      const next = el.querySelector(".series-next") as HTMLElement | null;
      const count = slides.length;
      if (!track || count === 0) return;

      const interval = Math.max(
        1500,
        parseInt(el.dataset.interval || "5000", 10) || 5000
      );
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      let current = 0;
      let timer: number | undefined;

      function animateFill() {
        fills.forEach((f, i) => {
          if (!f) return;
          f.style.transition = "none";
          f.style.width = "0%";
          if (i === current && !reduce) {
            void f.offsetWidth; // force reflow so the transition restarts
            f.style.transition = `width ${interval}ms linear`;
            f.style.width = "100%";
          }
        });
      }

      function render() {
        track!.style.transform = `translateX(-${current * 100}%)`;
        slides.forEach((s, i) =>
          s.setAttribute("aria-hidden", i === current ? "false" : "true")
        );
        dots.forEach((d, i) =>
          d.setAttribute("aria-current", i === current ? "true" : "false")
        );
        animateFill();
      }

      function stop() {
        if (timer) window.clearInterval(timer);
        timer = undefined;
      }

      function start() {
        stop();
        if (reduce || count < 2) return;
        timer = window.setInterval(() => go(current + 1), interval);
        (window as any).__seriesTimers.push(timer);
      }

      function go(to: number) {
        current = ((to % count) + count) % count;
        render();
        start();
      }

      if (count > 1) {
        next?.addEventListener("click", (e) => {
          e.preventDefault();
          go(current + 1);
        });
        prev?.addEventListener("click", (e) => {
          e.preventDefault();
          go(current - 1);
        });
        dots.forEach((d) =>
          d.addEventListener("click", (e) => {
            e.preventDefault();
            go(parseInt(d.dataset.index || "0", 10));
          })
        );
        el.addEventListener("mouseenter", stop);
        el.addEventListener("mouseleave", start);
        el.addEventListener("focusin", stop);
        el.addEventListener("focusout", start);
        el.addEventListener("keydown", (e) => {
          const ev = e as KeyboardEvent;
          if (ev.key === "ArrowRight") {
            ev.preventDefault();
            go(current + 1);
          } else if (ev.key === "ArrowLeft") {
            ev.preventDefault();
            go(current - 1);
          }
        });
      }

      render();
      start();
    });
  }

  (window as any).initSeriesCarousels = initSeriesCarousels;
  document.addEventListener("DOMContentLoaded", initSeriesCarousels);
  document.addEventListener("swup:contentReplaced", initSeriesCarousels);
</script>

<style>
  .series-dot {
    position: relative;
    width: 1.75rem;
    height: 0.3rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.45);
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }

  .series-dot[aria-current="true"] {
    background: rgba(255, 255, 255, 0.55);
  }

  .series-dot-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background: #ffffff;
    border-radius: 9999px;
  }
</style>
