---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '@/config';
import { shouldShowPost } from '@/utils/markdown';
import { getSeriesList, type SeriesDetail } from '@/utils/series';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Icon from '@/components/Icon.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const isDev = import.meta.env.DEV;
  try {
    const allPosts = await getCollection('posts');
    const list = getSeriesList(allPosts, isDev);
    return list.map((series) => ({
      params: { slug: series.slug },
      props: { series },
    }));
  } catch (error) {
    return [];
  }
};

const { series } = Astro.props as { series: SeriesDetail };

if (!series) {
  return Astro.redirect('/404');
}

// index.md 본문을 시리즈 소개글로 렌더링한다. 본문이 비어 있으면(프론트매터만
// 있는 index.md) 소개 영역 자체를 생략한다.
const { Content } = await render(series.index);
const hasIntro = (series.index.body || '').trim().length > 0;

// 소개 본문의 위키링크를 클라이언트에서 실제 글로 해석하기 위한 목록
const isDev = import.meta.env.DEV;
const allPosts = await getCollection('posts');
const visiblePosts = allPosts.filter((p) => shouldShowPost(p as any, isDev));

const seoData = {
  title: `${series.title} 시리즈 | ${siteConfig.title}`,
  description: series.summary || `${series.title} 시리즈에 포함된 글 모음`,
  canonical: Astro.url.href,
  ogType: 'website' as const,
};
---

<BaseLayout seoData={seoData}>
  <div class="py-8 relative">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 mb-12" style={`max-width: ${siteConfig.layout.contentWidth}`}>
      <!-- Back link -->
      <div class="mb-4">
        <a
          href="/posts"
          class="inline-flex items-center text-sm text-primary-600 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 transition-colors"
        >
          <Icon name="arrow-left" class="w-4 h-4 mr-1" />
          전체 글 보기
        </a>
      </div>

      <!-- Series header -->
      <header class="mb-8 overflow-hidden rounded-xl border border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-900">
        {series.imageUrl && (
          <div class="h-40 sm:h-48 md:h-56 overflow-hidden bg-primary-100 dark:bg-primary-800">
            <img
              src={series.imageUrl}
              alt={series.imageAlt}
              class="w-full h-full object-cover"
              width="1200"
              height="224"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
        <div class="p-5 sm:p-6">
          <span class="inline-block text-[0.7rem] font-semibold uppercase tracking-wide text-highlight-600 dark:text-highlight-400 mb-2">
            시리즈 · {series.count}개 글
          </span>
          <h1 class="text-xl sm:text-2xl font-bold text-primary-900 dark:text-primary-50 leading-tight mb-2">
            {series.title}
          </h1>
          {series.summary && (
            <p class="text-sm sm:text-base italic text-primary-500 dark:text-primary-400 leading-relaxed">
              {series.summary}
            </p>
          )}

          {hasIntro && (
            <div
              class="prose dark:prose-dark max-w-none mt-6 pt-6 border-t border-primary-200 dark:border-primary-700"
              id="series-content"
            >
              <Content />
            </div>
          )}
        </div>
      </header>

      <!-- Member posts (reading order: oldest first) -->
      <div class="space-y-4">
        {series.members.map((post, index) => (
          <PostCard post={post} context="posts" eager={index < 2} />
        ))}
      </div>
    </div>
  </div>

  {hasIntro && (
    <Fragment slot="scripts">
      <script define:vars={{ posts: visiblePosts }}>
        // 소개 본문 링크 후처리 - PostLayout 과 동일한 규칙을 적용한다.
        function processSeriesIntroLinks() {
          // 외부 링크는 새 탭으로
          document.querySelectorAll('#series-content a[href]').forEach(link => {
            const href = link.getAttribute('href');
            if (href && (href.startsWith('http://') || href.startsWith('https://'))) {
              if (!link.hasAttribute('target')) {
                link.setAttribute('target', '_blank');
                link.setAttribute('rel', 'noopener noreferrer');
              }
            }
          });

          // 위키링크를 실제 글 경로/제목으로 해석
          document.querySelectorAll('#series-content .wikilink[data-wikilink]').forEach(link => {
            const linkText = link.dataset.wikilink;
            const displayOverride = link.dataset.displayOverride;

            const slug = linkText.toLowerCase()
              .replace(/[^a-z0-9\s-]/g, '')
              .replace(/\s+/g, '-')
              .replace(/-+/g, '-')
              .replace(/^-+|-+$/g, '');

            const post = posts.find(p => p.slug === slug);

            if (post) {
              link.href = `/posts/${post.id}`;

              if (displayOverride && displayOverride !== 'null' && displayOverride !== 'undefined') {
                // [[link|display]] - 지정한 표시 텍스트 사용
                link.textContent = displayOverride;
              } else if (displayOverride === 'null' || displayOverride === null || displayOverride === 'undefined' || displayOverride === undefined) {
                // [text](url) - 표시 텍스트를 건드리지 않는다
              } else {
                // [[link]] - 글 제목으로 대체
                link.textContent = post.data.title;
              }
            } else {
              link.classList.add('wikilink-broken');
              link.title = 'Link not found';
            }
          });
        }

        document.addEventListener('DOMContentLoaded', processSeriesIntroLinks);
        document.addEventListener('swup:contentReplaced', () => setTimeout(processSeriesIntroLinks, 100));
      </script>
    </Fragment>
  )}
</BaseLayout>
